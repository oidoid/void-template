{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "target": "ES2024",
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "outDir": "dist/web/",
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "DOM.AsyncIterable",
      "DOM.Iterable",
      "ES2024",
      "ESNext.Disposable"
    ]
  },
  "include": ["src/web/**/*.ts"],
  // exclude colocated tests and test utils.
  "exclude": [
    "${configDir}/node_modules/",
    "${configDir}/dist/",
    "${configDir}/**/*.test.*",
    "${configDir}/**/test/"
  ]
}
